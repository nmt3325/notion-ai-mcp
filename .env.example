# Required. Copy the value from a logged-in Notion browser session.
NOTION_TOKEN_V2=

# Alternative to individual variables: notion_manager-compatible account JSON.
# Keep the file outside the repository or under ignored accounts/.
NOTION_ACCOUNT_FILE=

# Optional. If omitted, the server discovers these with loadUserContent.
NOTION_SPACE_ID=
NOTION_USER_ID=
NOTION_USER_NAME=
NOTION_USER_EMAIL=
NOTION_SPACE_NAME=
NOTION_SPACE_VIEW_ID=
# Persistently prefer this workspace after restart (also written by pin:true).
NOTION_PINNED_SPACE_ID=
NOTION_TIMEZONE=Asia/Tokyo

# Internal API compatibility knobs.
NOTION_API_BASE=https://www.notion.so/api/v3
NOTION_CLIENT_VERSION=23.13.20260313.1423
NOTION_DEFAULT_MODEL=almond-croissant-low
# New chats use Agent mode by default. Set to 1 only when Ask/read-only mode is desired.
NOTION_DEFAULT_READ_ONLY=0
NOTION_DEFAULT_WEB_SEARCH=1
NOTION_DEFAULT_WORKSPACE_SEARCH=1
NOTION_BROWSER_ID=
NOTION_DEVICE_ID=

# Remote Streamable HTTP MCP server. Generate with: openssl rand -hex 32
NOTION_MCP_HTTP_BEARER_TOKEN=
NOTION_MCP_HTTP_HOST=127.0.0.1
NOTION_MCP_HTTP_PORT=3000
NOTION_MCP_HTTP_PATH=/mcp
# Idle session TTL. The Notion client opens a brand-new MCP session on every
# reconnect, so a long TTL lets stale sessions pile up until the server starts
# rejecting new ones with 503 "MCP session limit reached".
NOTION_MCP_HTTP_SESSION_TTL_MS=300000
# Concurrent session cap. Raise this further if 503 responses persist.
NOTION_MCP_HTTP_MAX_SESSIONS=500

# Optional complete Cookie header. Prefer NOTION_TOKEN_V2 unless needed.
NOTION_FULL_COOKIE=

# Restrict attachment input/output paths to this root (defaults to process.cwd()).
NOTION_ATTACHMENT_ROOT=
# Maximum bytes for one attachment upload or download (default 20 MiB).
NOTION_MAX_ATTACHMENT_BYTES=20971520

# Automatically approve built-in Web URL safety confirmations from process startup.
# Applies to every discoverable ongoing account thread, including chats started in the browser.
# This trusts every HTTP(S) URL requested by Web fetch; URLs can carry private data in their query.
# No MCP/write/delete/connection permissions are granted. Set 0 to disable and restart.
NOTION_AUTO_CONFIRM_WEB=1
NOTION_AUTO_CONFIRM_WEB_POLL_MS=5000
NOTION_AUTO_CONFIRM_WEB_DISCOVERY_MS=30000
NOTION_AUTO_CONFIRM_WEB_CONCURRENCY=8
# Pending delivery receipts use web-confirmations.json beside NOTION_STATE_FILE (mode 0600).

# keep_me_awake watchdog. Set NOTION_KEEP_AWAKE=0 to remove the tools from the server.
NOTION_KEEP_AWAKE=1
# Silence that counts as a stalled turn. A healthy turn goes quiet for 10-20s between
# steps, so values under 60000 report stalls that are really just a slow tool call.
NOTION_KEEP_AWAKE_IDLE_MS=120000
# How often the watched thread record is read.
NOTION_KEEP_AWAKE_POLL_MS=30000
# Minimum gap between two nudges, so a nudge has time to land before the next one.
NOTION_KEEP_AWAKE_COOLDOWN_MS=60000
# Every nudge is a real turn and costs credits, so the budget and the deadline always apply.
NOTION_KEEP_AWAKE_MAX_NUDGES=40
NOTION_KEEP_AWAKE_DEADLINE_MS=10800000
# Origins allowed to call /mcp and /keep-awake from a browser (comma separated).
# Defaults to the Notion web origins, which is what the browser extension needs.
NOTION_MCP_HTTP_ALLOWED_ORIGINS=https://app.notion.com,https://www.notion.so,https://notion.so

# Beeper / Matrix bridge (npm run start:matrix).
# Use a dedicated Matrix bot account. Beeper encrypted rooms also require a recovery key.
MATRIX_BASE_URL=https://matrix.example.com
# Prefer an access token. Alternatively leave this empty and set username + password below.
MATRIX_ACCESS_TOKEN=
MATRIX_USERNAME=
MATRIX_PASSWORD=
MATRIX_USER_ID=
# Keep this stable for E2EE. If omitted, the durable state adapter persists the generated ID.
MATRIX_DEVICE_ID=
MATRIX_DEVICE_DISPLAY_NAME=Notion AI bridge
MATRIX_RECOVERY_KEY=
MATRIX_BOT_USERNAME=notion-ai
# Chat SDK slash-command parsing remains '/', while bridge commands use !help / !status / !new.
MATRIX_COMMAND_PREFIX=/
# Durable sync, login-session, subscription, E2EE bundle, and conversation mapping state.
MATRIX_STATE_FILE=
MATRIX_PERSISTENCE_KEY_PREFIX=notion-ai-matrix
# Rust/Matrix crypto database prefix. Must be writable when E2EE is enabled.
MATRIX_CRYPTO_DATABASE_PREFIX=
# Optional comma-separated Matrix room IDs accepted by the bot. Empty allows joined rooms.
MATRIX_ROOM_ALLOWLIST=
# Auto-join is disabled unless this is true or the inviter allowlist is non-empty.
MATRIX_INVITE_AUTOJOIN=0
MATRIX_INVITE_AUTOJOIN_ALLOWLIST=
MATRIX_LOG_LEVEL=info
MATRIX_SDK_LOG_LEVEL=error
MATRIX_SYNC_PERSIST_INTERVAL_MS=10000
MATRIX_POLL_INTERVAL_MS=3000
MATRIX_RESPONSE_TIMEOUT_MS=1800000
MATRIX_MAX_MESSAGE_CHARS=12000
# Optional per-bridge Notion overrides. Empty values use the normal NOTION_DEFAULT_* settings.
MATRIX_NOTION_MODEL=
MATRIX_NOTION_REASONING_EFFORT=
MATRIX_NOTION_WEB_SEARCH=
MATRIX_NOTION_WORKSPACE_SEARCH=
MATRIX_NOTION_READ_ONLY=
