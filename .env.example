# Required. Copy the value from a logged-in Notion browser session.
NOTION_TOKEN_V2=

# Alternative to individual variables: notion_manager-compatible account JSON.
# Keep the file outside the repository or under ignored accounts/.
NOTION_ACCOUNT_FILE=

# Optional. If omitted, the server discovers these with loadUserContent.
NOTION_SPACE_ID=
NOTION_USER_ID=
NOTION_USER_NAME=
NOTION_USER_EMAIL=
NOTION_SPACE_NAME=
NOTION_SPACE_VIEW_ID=
NOTION_PINNED_SPACE_ID=
NOTION_TIMEZONE=Asia/Tokyo

# Internal API compatibility knobs.
NOTION_API_BASE=https://www.notion.so/api/v3
NOTION_CLIENT_VERSION=23.13.20260313.1423
NOTION_DEFAULT_MODEL=almond-croissant-low
NOTION_BROWSER_ID=
NOTION_DEVICE_ID=

# Remote Streamable HTTP MCP server. Generate with: openssl rand -hex 32
NOTION_MCP_HTTP_BEARER_TOKEN=
NOTION_MCP_HTTP_HOST=127.0.0.1
NOTION_MCP_HTTP_PORT=3000
NOTION_MCP_HTTP_PATH=/mcp
NOTION_MCP_HTTP_SESSION_TTL_MS=3600000
NOTION_MCP_HTTP_MAX_SESSIONS=100

# Optional complete Cookie header. Prefer NOTION_TOKEN_V2 unless needed.
NOTION_FULL_COOKIE=

# Restrict attachment input/output paths to this root (defaults to process.cwd()).
NOTION_ATTACHMENT_ROOT=
# Maximum bytes for one attachment upload or download (default 20 MiB).
NOTION_MAX_ATTACHMENT_BYTES=20971520
